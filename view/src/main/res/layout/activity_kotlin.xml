<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <Button
        android:id="@+id/btnAsync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:drawable/btn_default"
        android:gravity="center"
        android:padding="6dp"
        android:text="Async"
        android:textAllCaps="false"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnAsyncLazy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:background="@android:drawable/btn_default"
        android:gravity="center"
        android:padding="6dp"
        android:text="AsyncLazy"
        android:textAllCaps="false"
        android:visibility="gone" />

    <com.suheng.structure.view.MaskFilterView
        android:id="@+id/maskFilterView"
        android:layout_width="240dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <com.suheng.structure.view.ComposeShaderView
        android:id="@+id/composeShaderView"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="-30dp" />

    <ImageView
        android:id="@+id/intersectView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <ImageView
        android:id="@+id/intersectView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />
</LinearLayout>
